  "delivery": {
    "inbound_path": "/data/Colt/pdf",
    "output_path": "/data/Colt/xls"
  },
  "notes": "Colt invoices are typically structured with clear charge detail tables. May include VAT for European billing. Currency is usually GBP or EUR.",
  "advanced": {
    "document_structure": {
      "detail_start_marker": "Service Level Activity",
      "detail_end_marker": null
    },
    "line_item_hints": {
      "subtotal_keywords": [
        "Subtotal",
        "Net Amount"
      ],
      "tax_keywords": [
        "VAT",
        "Tax",
        "MOMS",
        "BTW",
        "DPH"
      ],
      "detail_table_anchors": [
        "SERVICE LEVEL ACTIVITY",
        "Service Level Activity"
      ],
      "line_item_granularity": "per_charge_row",
      "service_id_preference": "first_identifier",
      "billing_reference_preference": "same_as_service_id",
      "service_id_column_label": null,
      "billing_reference_column_label": null,
      "skip_row_keywords": [
        "Total Current Charges",
        "Total Amount Due"
      ],
      "tax_output_mode": "calculate",
      "tax_rate_source": "auto",
      "table_column_labels": [
        "Service ID",
        "Description",
        "Amount",
        "Billing Period",
        "Tax Rate",
        "Tax Amount",
        "Total Net Charges",
        "Total Current Charges",
        "Amount Exclusive of"
      ]
    },
    "include_zero_amount_line_items": false,
    "require_line_item_identifier": false
  },
  "layout_fingerprint": {
    "summary_anchors": [
      "Due Date",
      "Invoice",
      "Billing Account Number",
      "Payment Details"
    ],
    "currency_codes": [
      "USD",
      "EUR",
      "CZK",
      "GBP",
      "SEK"
    ],
    "ignore_label_patterns": [
      "(?i)^total\\s+sweden$",
      "(?i)^total\\s+amsterdam",
      "(?i)for\\s+\\w+\\s+purposes\\s+only"
    ],
    "optional_column_patterns": [
      "(?i)^dia\\s+(actual|commit)\\s+usage$"
    ],
    "exclude_span_patterns": [
      "(?i)\\biban\\b",
      "(?i)\\bswift\\b",
      "(?i)\\bbeneficiary\\b",
      "(?i)\\bbank\\b",
      "(?i)\\bunicredit\\b"
    ]
  },
  "training_config": {
    "min_validation_successes": 3,
    "require_reconciliation": true
  },
