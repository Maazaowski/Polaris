# Polaris Docker Configuration
# Copy to .env before running: docker compose up -d

# ── REQUIRED ──────────────────────────────────────────────

# Your OpenAI API key (required for AI extraction)
POLARIS_OPENAI_API_KEY=sk-your-key-here

# Production database (REQUIRED for `docker compose up`). The base compose has
# no local MySQL — it connects to whatever this points at. Not needed when
# running the dev overlay (docker-compose.dev.yml), which starts a local MySQL
# and overrides this value.
POLARIS_DATABASE_URL=mysql+pymysql://USER:PASSWORD@PROD-MYSQL-HOST:3306/polaris

# ── OPTIONAL (defaults work for most setups) ─────────────

# Host directory where Polaris stores all data (PDFs, output XLSX/JSON, etc.)
# This folder will appear on your Windows machine with the completed output files.
# Default: C:\Polaris
POLARIS_HOST_DATA_DIR=C:\Polaris

# Local MySQL passwords — used ONLY by the dev overlay (docker-compose.dev.yml).
# Ignored in production (no local DB there).
MYSQL_ROOT_PASSWORD=polaris
MYSQL_PASSWORD=polaris

# OpenAI models
POLARIS_OPENAI_MODEL_CLASSIFICATION=gpt-4o-mini
POLARIS_OPENAI_MODEL_EXTRACTION=gpt-4o
POLARIS_AI_EXTRACTION_MODE=compact_chunked
POLARIS_AI_CHUNK_MAX_LAYOUT_CHARS=24000
POLARIS_AI_CHUNK_OVERLAP_ROWS=3
POLARIS_AI_CHUNK_MAX_RETRIES=3
POLARIS_AI_CHUNK_CONCURRENCY=1

# Extraction thresholds
POLARIS_CONFIDENCE_THRESHOLD=0.75
POLARIS_MODEL_CONFIDENCE_THRESHOLD=0.80
POLARIS_RECONCILIATION_VARIANCE_THRESHOLD=0.01
